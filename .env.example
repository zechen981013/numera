# ========== MySQL Database ==========
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=crm

# ========== OpenAI / LLM ==========
# 你的 OpenAI API Key（不设置则必须开启 AI_MOCK_MODE=true 才能提问）
OPENAI_API_KEY=
# 使用的模型名，统一在这里配置
OPENAI_MODEL=gpt-4o-mini
# 可选：自定义 OpenAI 兼容接口地址（例如 One API / 中转站）
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM 请求超时（毫秒）
OPENAI_TIMEOUT_MS=30000

# ========== AI Mode ==========
# true  = 使用内置 Mock 生成 SQL（仅用于无 API Key 时的测试，答案仍来自真实 MySQL 执行结果）
# false = 使用真实 LLM（OpenAI）生成 SQL 与最终回答
AI_MOCK_MODE=true

# ========== Backend ==========
PORT=4000
# 查询历史存储文件路径（默认为 backend/.data/history.json）
# HISTORY_FILE=backend/.data/history.json

# ========== RBAC 初始账号 ==========
# 首次启动时会写入 backend/.data/users.json；之后账号以该文件为准
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
USER_USERNAME=user
USER_PASSWORD=user123
