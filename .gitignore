config.local.*
*.local
deploy/.env
deploy/hosts.local
hosts.local
*.private.*

# --- python ---
.venv/
.venv310/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.uv/
